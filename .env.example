# Este repositorio es un monorepo con dos aplicaciones.
# Cada una tiene su propio archivo de variables:
#
#   server/.env.example  ->  copiar a server/.env
#   client/.env.example  ->  copiar a client/.env
#
# Resumen de variables:
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/campus_league
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria
JWT_EXPIRE=30m
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api