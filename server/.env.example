# ===== Servidor =====
# Puerto donde corre la API
PORT=5000
# development | production
NODE_ENV=development

# ===== Base de datos =====
# Local:  mongodb://127.0.0.1:27017/campus_league
# Atlas:  mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/campus_league?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/campus_league

# ===== Seguridad JWT =====
# Cadena larga y aleatoria. Generar con:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria
# Expiración del token (ej: 30m, 1h, 7d)
JWT_EXPIRE=30m

# ===== Bcrypt =====
# Salt factor (mínimo 10)
BCRYPT_SALT_ROUNDS=10

# ===== Cifrado AES-256 de datos sensibles (RNF-002) =====
# 64 caracteres hexadecimales (32 bytes). Generar con:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Obligatoria en producción; en desarrollo se deriva de JWT_SECRET si está vacía.
ENCRYPTION_KEY=

# ===== CORS =====
# URL del frontend autorizada para consumir la API
FRONTEND_URL=http://localhost:5173

# ===== Swagger =====
# URL pública de la API en producción (se muestra en /api-docs)
API_PROD_URL=https://tu-api-en-produccion.com

# ===== Correo (RF-014) =====
# Sin SMTP_HOST los correos se simulan en consola (modo desarrollo).
# Ejemplo Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=cuenta, SMTP_PASS=clave_de_aplicacion
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Campus League <no-reply@uab.edu.bo>
# (Opcional) Envía TODOS los correos a este buzón; útil en demostraciones y pruebas
MAIL_REDIRECT_TO=

# ===== Límite de intentos en /api/auth (por IP, ventana de 15 min) =====
RATE_LIMIT_MAX=100

